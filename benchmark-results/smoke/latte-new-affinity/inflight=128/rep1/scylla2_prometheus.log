scylla_memory_system_dirty_bytes{shard="0"} 2621440.000000
scylla_memory_system_dirty_bytes{shard="1"} 262144.000000
scylla_memory_system_dirty_bytes{shard="2"} 262144.000000
scylla_memory_system_dirty_bytes{shard="3"} 262144.000000
